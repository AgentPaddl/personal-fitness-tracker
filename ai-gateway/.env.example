# Server-side values only; never ship these in the iOS application.
# Valid values today: "fake" (deterministic, no credentials required).
# "copilot_sdk" is reserved for the future production adapter and is not implemented yet.
AI_PROVIDER=fake
AI_PROVIDER_TIMEOUT_SECONDS=10
# Development-only bypass; must be false before any non-local exposure.
GATEWAY_DEV_AUTH_BYPASS=true
