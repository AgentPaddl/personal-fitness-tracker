# Server-side values only; never ship these in the iOS application.

# Fails closed by default: the gateway will not start unless this is set.
# "development" is required to enable GATEWAY_DEV_AUTH_BYPASS and to allow
# AI_PROVIDER=fake. "production" and "test" never allow the dev bypass.
APP_ENV=development

# Valid values today: "fake" (deterministic, no credentials required) and
# "copilot" (real GitHub Copilot SDK adapter, requires local Copilot CLI
# authentication - see README.md). "fake" is rejected when APP_ENV=production.
AI_PROVIDER=fake
AI_PROVIDER_TIMEOUT_SECONDS=10

# Server-side, opaque model-routing key for the food-text use case. Never
# exposed through the public API; safe to change without affecting the
# public request/response contract.
FOOD_TEXT_MODEL_PURPOSE=food_text_v1

# Server-side, opaque model-routing key for image-based food analysis.
# Kept separate from FOOD_TEXT_MODEL_PURPOSE because it requires a
# vision-capable model; never exposed through the public API.
FOOD_IMAGE_MODEL_PURPOSE=food_image_v1

# Development-only bypass, off by default. Only takes effect when
# APP_ENV=development; must never be true outside a trusted local
# environment. In any other environment, the caller must present a valid
# X-Service-Token header (GATEWAY_SERVICE_TOKEN) instead - see AGENTS.md.
GATEWAY_DEV_AUTH_BYPASS=false

# Required when APP_ENV=production (fails closed at startup otherwise). The
# backend must present this exact value as `X-Service-Token` on every
# `/v1/*` call. The gateway is never a public API - this only ever
# authenticates our own backend. Generate a long random value, e.g.:
#   openssl rand -base64 32
# Must differ from the backend's own BACKEND_API_KEY. Never commit a real
# value here.
GATEWAY_SERVICE_TOKEN=

# Small, fail-fast cap on simultaneous provider calls (each holds a Copilot
# CLI session). A request that cannot get a slot immediately is rejected
# (503 service_saturated), never queued. 1-20.
AI_PROVIDER_MAX_CONCURRENCY=2

# Required only when AI_PROVIDER=copilot. JSON object mapping each
# server-side model-routing purpose to a concrete Copilot model id. There is
# no default: a model is never silently substituted. Available ids vary by
# plan/time; check client.list_models(). The food-image route requires a
# vision-capable model (check model.capabilities.supports.vision via
# list_models(), or GET /readyz). Example:
# COPILOT_MODEL_ROUTES_JSON={"food_text_v1": "gpt-5-mini", "food_image_v1": "gpt-5-mini"}
COPILOT_MODEL_ROUTES_JSON=

# Optional. Only set this for a non-interactive/server-to-server token (see
# README.md). Leave unset to use the Copilot CLI's own locally logged-in
# session (`copilot` then `/login`), which is the recommended local setup.
# Never commit a real value here.
COPILOT_GITHUB_TOKEN=

# Real Copilot calls take tens of seconds; raise this when AI_PROVIDER=copilot
# (the 10s default is tuned for the fake provider and will falsely time out).
# AI_PROVIDER_TIMEOUT_SECONDS=90
