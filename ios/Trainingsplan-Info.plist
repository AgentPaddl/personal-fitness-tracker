<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Narrow, local-development-only exception: allows plain HTTP to
		     literal IP-address hosts (e.g. the developer's Mac on the LAN)
		     and .local mDNS hostnames only. Does NOT set
		     NSAllowsArbitraryLoads and does NOT relax ATS for ordinary
		     internet domains; HTTPS is still required for those. See
		     ios/AGENTS.md for exact scope/rationale. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS's separate Local Network privacy permission (distinct from the
	     ATS exception above): required for a physical device to reach the
	     developer's Mac on the LAN at all. Triggers a one-time system
	     permission prompt; only used for API_BASE_URL, never for anything
	     else. See ios/AGENTS.md for exact scope/rationale. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Wird nur verwendet, um sich während der Entwicklung mit dem Backend auf deinem Mac im lokalen Netzwerk zu verbinden.</string>
	<!-- Camera capture for the food-analysis flow ("Foto aufnehmen"). Only
	     requested when the user explicitly taps that action; never on
	     launch. Captured photos are never saved to the Photos library. -->
	<key>NSCameraUsageDescription</key>
	<string>Wird verwendet, um ein Foto deines Essens für die KI-Analyse aufzunehmen.</string>
	<!-- MSAL's documented default iOS/macOS redirect URI format is
	     msauth.[BUNDLE_ID]://auth (see
	     https://learn.microsoft.com/entra/msal/objc/redirect-uris-ios).
	     Bundle ID here is com.benedikt.Trainingsplan (see
	     PRODUCT_BUNDLE_IDENTIFIER in project.pbxproj); this scheme must
	     also be registered as a redirect URI on the native/public-client
	     Entra app registration (see docs/architecture.md's Entra setup
	     checklist). This is a public identifier, not a secret. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.com.benedikt.Trainingsplan</string>
			</array>
		</dict>
	</array>
	<!-- Non-secret Entra ID/MSAL configuration (tenant ID, client ID, API
	     scope, redirect URI - all public identifiers, never secrets; see
	     EntraConfiguration.load(bundle:)). Values come from
	     ENTRA_TENANT_ID/ENTRA_CLIENT_ID/ENTRA_API_SCOPE/ENTRA_REDIRECT_URI
	     build settings via Xcode's standard $(VAR) Info.plist variable
	     substitution, so they can differ per build configuration:
	     intentionally blank in Debug (EntraConfiguration.load(bundle:)
	     treats a blank string as absent, matching today's local-dev
	     behavior with no MSAL interaction) and set to the real Entra app
	     registration values in Release (see docs/architecture.md's Phase 8
	     entry). Never set to a client secret or any token. -->
	<key>EntraTenantID</key>
	<string>$(ENTRA_TENANT_ID)</string>
	<key>EntraClientID</key>
	<string>$(ENTRA_CLIENT_ID)</string>
	<key>EntraAPIScope</key>
	<string>$(ENTRA_API_SCOPE)</string>
	<key>EntraRedirectURI</key>
	<string>$(ENTRA_REDIRECT_URI)</string>
	<!-- Lets MSAL detect whether Microsoft Authenticator/Company Portal are
	     installed for brokered SSO; does not grant those apps any access
	     to this app's data. Documented MSAL iOS requirement independent of
	     whether a broker is actually installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>msauthv2</string>
		<string>msauthv3</string>
	</array>
</dict>
</plist>
