# Server-side values only; never ship these in the iOS application.

# Fails closed by default: in production (the default when unset), the
# food-analysis route requires a valid X-API-Key header (BACKEND_API_KEY)
# instead of the development bypass below.
APP_ENV=development

AI_GATEWAY_BASE_URL=http://127.0.0.1:8000
AI_GATEWAY_TIMEOUT_SECONDS=10

# Required when APP_ENV=production (validate_config() fails closed at
# startup otherwise). The iOS app must present this exact value as
# `X-API-Key` on every request. Generate a long random value, e.g.:
#   openssl rand -base64 32
# Never commit a real value here.
BACKEND_API_KEY=

# Required when APP_ENV=production. Forwarded to the gateway as
# `X-Service-Token`; must match the gateway's own GATEWAY_SERVICE_TOKEN.
# Generate the same way as BACKEND_API_KEY, but as a separate value - the
# two secrets must never be the same. Never commit a real value here.
GATEWAY_SERVICE_TOKEN=

# Recommended production values (see backend/AGENTS.md's timeout hierarchy):
# AI_GATEWAY_TIMEOUT_SECONDS=100
