# Server-side values only; never ship these in the iOS application.

# Fails closed by default: in production (the default when unset), the
# food-analysis route requires Azure Easy Auth / Microsoft Entra ID to
# authenticate the caller before the backend trusts it. Local development
# may use the bypass below.
APP_ENV=development

AI_GATEWAY_BASE_URL=http://127.0.0.1:8000
AI_GATEWAY_TIMEOUT_SECONDS=10

# Server-side flag set by Azure App Service / Functions when Easy Auth is
# enforced for the public backend. The backend must not trust any caller
# unless this flag is true and Azure has injected the identity header.
EASY_AUTH_ENABLED=false

# Required when APP_ENV=production. Forwarded to the gateway as
# `X-Service-Token`; must match the gateway's own GATEWAY_SERVICE_TOKEN.
# Generate a long random value, e.g.: openssl rand -base64 32
# Never commit a real value here.
GATEWAY_SERVICE_TOKEN=

# Recommended production values (see backend/AGENTS.md's timeout hierarchy):
# AI_GATEWAY_TIMEOUT_SECONDS=100
